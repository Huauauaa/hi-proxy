{
  "name": "hi-proxy",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Monorepo: OpenAI-compatible gateway (apps/server) + chat web UI (apps/web)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm -F @hi-proxy/server dev",
    "start": "pnpm -F @hi-proxy/server start",
    "build": "pnpm -r build",
    "serve": "pnpm -F @hi-proxy/server serve",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -F @hi-proxy/server test",
    "web": "pnpm -F @hi-proxy/web dev",
    "web:build": "pnpm -F @hi-proxy/web build"
  }
}
